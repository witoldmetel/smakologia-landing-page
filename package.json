{
  "name": "smakologia-landing-page",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 astro",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "biome lint src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "check-unused-files": "knip",
    "check-seo": "ASTRO_SITE=https://smakologia.com pnpm run build && node scripts/verify-seo.mjs",
    "check-lighthouse": "ASTRO_SITE=http://localhost:4321 pnpm run build && pnpm dlx @lhci/cli@0.15.1 autorun --config=./lighthouserc.json",
    "check-updates": "pnpm dlx npm-check-updates"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "schema-dts": "2.1.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.15",
    "knip": "6.41.0",
    "typescript": "6.0.3"
  }
}
