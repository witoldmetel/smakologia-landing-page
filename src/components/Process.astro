---
import { siteConfig } from '../config/site';
---

<section
  id="jak-pracujemy"
  aria-labelledby="process-heading"
  class="py-16 sm:py-24"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal-on-scroll mx-auto max-w-3xl text-center">
      <p class="text-xs font-bold tracking-widest text-clay-700 uppercase">
        Droga do celu w 3 krokach
      </p>
      <h2
        id="process-heading"
        class="mt-2 font-serif text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl"
      >
        Jak wygląda współpraca w Smakologii?
      </h2>
      <p class="mt-4 text-base leading-relaxed text-ink-800 sm:text-lg">
        Zdrowa zmiana nie polega na chwilowych wyrzeczeniach, lecz na mądrym planie, w którym Twoje potrzeby są zawsze na pierwszym miejscu.
      </p>
    </div>

    <ol class="mt-12 grid gap-8 lg:grid-cols-3">
      {
        siteConfig.processSteps.map((step) => (
          <li class="reveal-on-scroll group relative flex flex-col justify-between rounded-3xl border border-sage-400/30 bg-cream-50 p-7 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-sage-500 hover:shadow-xl hover:shadow-sage-900/8 sm:p-8">
            <div>
              <div class="flex items-center justify-between">
                <span class="rounded-full bg-clay-100 px-3.5 py-1 text-xs font-bold text-clay-700 uppercase">
                  {step.badge}
                </span>
                <span class="font-serif text-3xl font-extrabold text-sage-600 transition-transform duration-300 group-hover:scale-110" aria-hidden="true">
                  {step.stepNumber}
                </span>
              </div>

              <h3 class="mt-5 font-serif text-2xl font-bold text-ink-900">
                {step.title}
              </h3>

              <p class="mt-2 text-sm font-bold text-sage-700 italic">
                „{step.quote}”
              </p>

              <p class="mt-4 text-sm leading-relaxed text-ink-800 sm:text-base">
                {step.description}
              </p>
            </div>

            <ul class="mt-6 space-y-2.5 border-t border-cream-200 pt-5 text-xs font-medium text-ink-800 sm:text-sm">
              {step.deliverables.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 font-bold text-sage-600" aria-hidden="true">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
