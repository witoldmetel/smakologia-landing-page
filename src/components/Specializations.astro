---
import { siteConfig } from '../config/site';
---

<section
  id="specjalizacje"
  aria-labelledby="specializations-heading"
  class="border-y border-cream-300/70 bg-cream-50 py-16 sm:py-24"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-bold tracking-widest text-clay-700 uppercase">
        Obszary współpracy
      </p>
      <h2
        id="specializations-heading"
        class="mt-2 font-serif text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl"
      >
        W czym mogę Ci pomóc?
      </h2>
      <p class="mt-4 text-base leading-relaxed text-ink-800 sm:text-lg">
        Każdy organizm i historia żywieniowa są inne. Dlatego łączę naukowe podstawy dietetyki klinicznej z psychodietetyką, tworząc rozwiązania skrojone na miarę Twoich potrzeb.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        siteConfig.specializations.map((spec) => (
          <article class="flex flex-col justify-between rounded-3xl border border-cream-300 bg-cream-100/70 p-7 shadow-xs transition-shadow hover:shadow-md sm:p-8">
            <div>
              <div class="flex items-center justify-between gap-4">
                <span class="inline-flex items-center rounded-full bg-sage-100 px-3.5 py-1 text-xs font-bold text-sage-800">
                  {spec.badge}
                </span>
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-sage-700 text-cream-50" aria-hidden="true">
                  {spec.iconName === 'clinical' && (
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                    </svg>
                  )}
                  {spec.iconName === 'psycho' && (
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 2a8 8 0 0 0-8 8c0 3.5 2.5 6.5 6 7.5V21h4v-3.5c3.5-1 6-4 6-7.5a8 8 0 0 0-8-8Z" />
                    </svg>
                  )}
                  {spec.iconName === 'weight' && (
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 20V10m6 10V4M6 20v-4" />
                    </svg>
                  )}
                  {spec.iconName === 'hybrid' && (
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                      <circle cx="12" cy="10" r="3" />
                    </svg>
                  )}
                </span>
              </div>

              <h3 class="mt-5 font-serif text-2xl font-bold text-ink-900">
                {spec.title}
              </h3>

              <p class="mt-3 text-sm leading-relaxed text-ink-800 sm:text-base">
                {spec.description}
              </p>

              <ul class="mt-6 space-y-2.5 border-t border-cream-300/80 pt-5 text-sm text-ink-800">
                {spec.conditions.map((condition) => (
                  <li class="flex items-start gap-2.5">
                    <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-clay-600" aria-hidden="true" />
                    <span>{condition}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
