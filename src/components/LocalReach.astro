---
import { siteConfig } from '../config/site';
---

<section
  id="dojazd"
  aria-labelledby="local-reach-heading"
  class="py-16 sm:py-24"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-cream-300 bg-sage-800 p-8 text-cream-50 shadow-lg sm:p-12">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <span class="inline-flex items-center rounded-full bg-cream-50/15 px-3.5 py-1 text-xs font-bold tracking-wider text-cream-100 uppercase">
            Lokalizacja przy węźle DK86
          </span>
          <h2
            id="local-reach-heading"
            class="mt-4 font-serif text-3xl font-bold tracking-tight text-cream-50 sm:text-4xl"
          >
            Dietetyk Będzin, Katowice, Sosnowiec i całe Zagłębie
          </h2>
          <p class="mt-4 text-base leading-relaxed text-cream-100">
            {siteConfig.contact.address.locationHighlight}
          </p>
          <p class="mt-4 text-sm leading-relaxed text-cream-200">
            Gabinet przy <strong>{siteConfig.contact.address.fullDisplay}</strong> pozwala ominąć zakorkowane centra miast i dotrzeć na wizytę w kilkanaście minut z całej aglomeracji.
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href={siteConfig.contact.googleMapsDirectionsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl bg-cream-50 px-5 py-3 text-sm font-bold text-sage-900 transition-colors hover:bg-cream-200"
            >
              <span>Wyznacz trasę w Google Maps</span>
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M7 7h10v10" />
              </svg>
            </a>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="grid gap-4 sm:grid-cols-2">
            {
              siteConfig.commuteCities.map((item) => (
                <div class="rounded-2xl border border-cream-50/15 bg-sage-900/75 p-5">
                  <div class="flex items-center justify-between gap-2">
                    <h3 class="font-serif text-lg font-bold text-cream-50">
                      {item.city}
                    </h3>
                    <span class="rounded-lg bg-cream-50 px-2.5 py-1 text-xs font-extrabold text-sage-900">
                      {item.driveTime}
                    </span>
                  </div>
                  <p class="mt-2 text-xs leading-relaxed text-cream-200">
                    {item.routeNote}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
