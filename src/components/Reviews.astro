---
import { siteConfig } from '../config/site';

const visibleReviews = siteConfig.reviews.items.filter(
  (review) => review.source === 'google' || siteConfig.reviews.dietDoctorReviewsEnabled,
);
---

<section
  id="opinie"
  aria-labelledby="reviews-heading"
  class="border-t border-cream-300/70 bg-gradient-to-b from-cream-100 via-sage-50/50 to-cream-100 py-16 sm:py-24"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal-on-scroll flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end">
      <div class="max-w-2xl">
        <p class="text-xs font-bold tracking-widest text-clay-700 uppercase">
          Zaufanie i efekty współpracy
        </p>
        <h2
          id="reviews-heading"
          class="mt-2 font-serif text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl"
        >
          Opinie pacjentów z Google Maps
          {siteConfig.reviews.dietDoctorReviewsEnabled && ' oraz DietDoctor.pl'}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-800 sm:text-lg">
          Największą satysfakcją są dla mnie trwałe nawyki, lepsze wyniki badań i uśmiech pacjentów, którzy odkryli, że zdrowa dieta może być prosta i smaczna.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4 rounded-2xl border border-sage-400/35 bg-cream-50 px-5 py-4 shadow-sm">
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-sage-50 ring-1 ring-sage-200" aria-hidden="true">
            <svg class="h-6 w-6" viewBox="0 0 24 24">
              <path
                fill="#4285F4"
                d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82Z"
              />
              <path
                fill="#34A853"
                d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24Z"
              />
              <path
                fill="#FBBC05"
                d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.13-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.98-3.09Z"
              />
              <path
                fill="#EA4335"
                d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09c.95-2.85 3.6-4.96 6.73-4.96Z"
              />
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="font-serif text-xl font-extrabold text-ink-900">
                {siteConfig.reviews.averageRating} / 5.0
              </span>
              <div class="flex items-center text-amber-500" role="img" aria-label="Ocena 5 na 5 gwiazdek">
                {Array.from({ length: 5 }).map(() => (
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292Z" />
                  </svg>
                ))}
              </div>
            </div>
            <p class="text-xs font-semibold text-ink-700">
              Wizytówka Google: SMAKOLOGIA
            </p>
          </div>
        </div>

        <a
          href={siteConfig.reviews.googleProfileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-xl bg-sage-700 px-4 py-2.5 text-xs font-bold text-cream-50 transition-all duration-300 hover:bg-sage-800"
        >
          <span>Zobacz w Google Maps</span>
          <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M7 7h10v10" />
          </svg>
        </a>
      </div>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        visibleReviews.map((review) => (
          <article class="reveal-on-scroll group flex flex-col justify-between rounded-3xl border border-sage-400/30 bg-cream-50 p-7 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-sage-500 hover:shadow-xl hover:shadow-sage-900/8 sm:p-8">
            <div>
              <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-1 text-amber-500" role="img" aria-label={`Ocena ${review.rating} na 5 gwiazdek`}>
                  {Array.from({ length: review.rating }).map(() => (
                    <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292Z" />
                    </svg>
                  ))}
                </div>

                <span class="inline-flex items-center gap-1.5 rounded-full bg-sage-50 px-3 py-1 text-xs font-bold text-sage-800 ring-1 ring-sage-200">
                  {review.source === 'google' ? 'Google Maps' : 'DietDoctor.pl'}
                </span>
              </div>

              <p class="mt-4 inline-block rounded-lg bg-clay-50 px-2.5 py-1 text-xs font-bold text-clay-700">
                {review.contextTag}
              </p>

              <blockquote class="mt-4 text-sm leading-relaxed text-ink-800 sm:text-base">
                „{review.text}”
              </blockquote>
            </div>

            <div class="mt-6 flex items-center justify-between border-t border-cream-200 pt-4">
              <div class="flex items-center gap-3">
                <span
                  class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-sage-600 to-sage-800 text-xs font-bold text-cream-50"
                  aria-hidden="true"
                >
                  {review.author.charAt(0)}
                </span>
                <div>
                  <p class="text-sm font-bold text-ink-900">{review.author}</p>
                  <p class="text-xs text-ink-700">{review.dateLabel}</p>
                </div>
              </div>
              <span class="text-xs font-bold text-sage-700">✓ Zweryfikowana</span>
            </div>
          </article>
        ))
      }
    </div>

    <div class="reveal-on-scroll mt-8 flex flex-wrap items-center justify-center gap-4 text-center">
      <a
        href={siteConfig.reviews.googleProfileUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-2xl border-2 border-sage-400/45 bg-cream-50 px-6 py-3.5 text-sm font-bold text-ink-900 transition-all duration-300 hover:-translate-y-0.5 hover:border-sage-600 hover:bg-sage-50"
      >
        <span>Sprawdź wszystkie opinie lub dodaj własną w Google Maps</span>
        <svg class="h-4 w-4 shrink-0 text-sage-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M7 7h10v10" />
        </svg>
      </a>

      {
        siteConfig.reviews.dietDoctorReviewsEnabled && (
          <a
            href={siteConfig.reviews.dietDoctorProfileUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-2xl border-2 border-sage-400/45 bg-cream-50 px-6 py-3.5 text-sm font-bold text-ink-900 transition-all duration-300 hover:-translate-y-0.5 hover:border-sage-600 hover:bg-sage-50"
          >
            <span>Zobacz profil i opinie na DietDoctor.pl</span>
            <svg class="h-4 w-4 shrink-0 text-sage-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M7 7h10v10" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</section>
