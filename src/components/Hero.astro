---
import { siteConfig } from '../config/site';
---

<section
  id="hero"
  aria-labelledby="hero-heading"
  class="relative overflow-hidden border-b border-cream-300/70 bg-gradient-to-br from-cream-50 via-sage-50/70 to-cream-200/80 py-14 sm:py-20 lg:py-24"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-28 -right-24 h-96 w-96 rounded-full bg-sage-200/45 blur-3xl"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-28 -left-24 h-80 w-80 rounded-full bg-clay-100/50 blur-3xl"
  ></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2.5 rounded-full border border-sage-400/35 bg-cream-50/90 px-4 py-1.5 text-xs font-bold tracking-wide text-sage-800 uppercase shadow-2xs backdrop-blur-xs">
          <span class="relative flex h-2.5 w-2.5 shrink-0" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-sage-400 opacity-75"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-sage-600"></span>
          </span>
          <span>Gabinet w Będzinie (przy DK86) oraz Konsultacje Online</span>
        </div>

        <h1
          id="hero-heading"
          class="mt-6 font-serif text-4xl font-bold tracking-tight text-ink-900 sm:text-5xl lg:text-[3.35rem] lg:leading-[1.12]"
        >
          Dietetyk kliniczny i&nbsp;psychodietetyk w&nbsp;Będzinie — <span class="bg-gradient-to-r from-sage-800 via-sage-600 to-sage-500 bg-clip-text text-transparent">zdrowa dieta dopasowana do Ciebie</span>
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-800 sm:text-xl">
          Wszystko zaczyna się w Twojej głowie! Wspólnie ułożymy smaczne, zdrowe menu dopasowane do Twoich wyników badań, stylu życia i ulubionych smaków. Wspieram pacjentów z Będzina, Katowic, Sosnowca, Dąbrowy Górniczej, Chorzowa, Siewierza oraz online.
        </p>

        <div class="mt-8 flex flex-col gap-3.5 sm:flex-row sm:items-center">
          <a
            href={siteConfig.contact.phoneHref}
            class="group inline-flex items-center justify-center gap-2.5 rounded-2xl bg-sage-700 px-7 py-4 text-base font-bold text-cream-50 shadow-md shadow-sage-900/15 transition-all duration-300 hover:-translate-y-0.5 hover:bg-sage-800 hover:shadow-lg hover:shadow-sage-900/20"
          >
            <svg class="h-5 w-5 shrink-0 transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <span>Umów wizytę: {siteConfig.contact.phoneDisplay}</span>
          </a>

          <a
            href="#jak-pracujemy"
            class="group inline-flex items-center justify-center gap-2 rounded-2xl border-2 border-sage-400/40 bg-cream-50/90 px-6 py-4 text-base font-bold text-ink-900 transition-all duration-300 hover:-translate-y-0.5 hover:border-sage-600 hover:bg-sage-50"
          >
            <span>Zobacz, jak pracujemy</span>
            <svg class="h-4 w-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7" />
            </svg>
          </a>
        </div>

        <dl class="mt-10 grid grid-cols-1 gap-4 border-t border-cream-300/90 pt-8 sm:grid-cols-3">
          <div class="rounded-2xl bg-cream-50/95 p-4 shadow-2xs ring-1 ring-sage-400/25 transition-all duration-300 hover:-translate-y-0.5 hover:ring-sage-400/60">
            <dt class="text-xs font-bold tracking-wider text-sage-700 uppercase">Lokalizacja gabinetu</dt>
            <dd class="mt-1 text-sm font-bold text-ink-900">Będzin, ul. Gzichowska 121</dd>
            <dd class="mt-0.5 text-xs text-ink-700">Przy zjeździe z trasy DK86</dd>
          </div>
          <div class="rounded-2xl bg-cream-50/95 p-4 shadow-2xs ring-1 ring-sage-400/25 transition-all duration-300 hover:-translate-y-0.5 hover:ring-sage-400/60">
            <dt class="text-xs font-bold tracking-wider text-sage-700 uppercase">Specjalizacja</dt>
            <dd class="mt-1 text-sm font-bold text-ink-900">Kliniczna i Psychodietetyka</dd>
            <dd class="mt-0.5 text-xs text-ink-700">Choroby, nawyki i redukcja</dd>
          </div>
          <div class="rounded-2xl bg-cream-50/95 p-4 shadow-2xs ring-1 ring-sage-400/25 transition-all duration-300 hover:-translate-y-0.5 hover:ring-sage-400/60">
            <dt class="text-xs font-bold tracking-wider text-sage-700 uppercase">Zasięg opieki</dt>
            <dd class="mt-1 text-sm font-bold text-ink-900">Śląsk, Zagłębie i Online</dd>
            <dd class="mt-0.5 text-xs text-ink-700">Katowice, Sosnowiec, Dąbrowa Górnicza</dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-5">
        <div class="relative w-full">
          <div class="rounded-3xl border border-sage-400/35 bg-cream-50 p-6 shadow-xl shadow-sage-900/8 sm:p-8">
            <div class="flex items-center justify-between border-b border-cream-200 pb-5">
              <div>
                <p class="text-xs font-bold tracking-wider text-clay-700 uppercase">Filozofia Smakologii</p>
                <p class="mt-1 font-serif text-xl font-bold text-ink-900">Partnerska współpraca</p>
              </div>
              <div class="animate-float-slow flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-sage-600 to-sage-800 text-cream-50 shadow-sm">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4" />
                </svg>
              </div>
            </div>

            <blockquote class="mt-6 rounded-2xl bg-sage-50 p-5 text-sm leading-relaxed font-medium text-ink-900 ring-1 ring-sage-200">
              „Stworzymy razem naszą małą firmę, w której to <strong>TY będziesz dyrektorem</strong>, a ja, jako Twój prywatny asystent, dołożę wszelkich starań, aby wyniki naszej pracy były dla Ciebie satysfakcjonujące!”
            </blockquote>

            <ul class="mt-6 space-y-3.5 text-sm text-ink-800">
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sage-700 text-xs font-bold text-cream-50" aria-hidden="true">✓</span>
                <span><strong>Dietoterapia kliniczna</strong> dopasowana do Twoich wyników badań i jednostek chorobowych</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sage-700 text-xs font-bold text-cream-50" aria-hidden="true">✓</span>
                <span><strong>Wsparcie psychodietetyka</strong> w budowaniu zdrowej relacji z jedzeniem bez zakazów</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sage-700 text-xs font-bold text-cream-50" aria-hidden="true">✓</span>
                <span><strong>Proste i smaczne posiłki</strong> z produktów dostępnych w każdym sklepie</span>
              </li>
            </ul>

            <div class="mt-7 rounded-2xl bg-sage-50/70 p-4 ring-1 ring-sage-200">
              <p class="text-xs font-bold text-ink-800 uppercase">Szybki kontakt bezpośredni</p>
              <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
                <a href={siteConfig.contact.phoneHref} class="text-base font-extrabold text-sage-800 hover:underline">
                  {siteConfig.contact.phoneDisplay}
                </a>
                <a href={siteConfig.contact.emailHref} class="text-xs font-bold text-ink-800 underline hover:text-sage-800">
                  {siteConfig.contact.email}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
