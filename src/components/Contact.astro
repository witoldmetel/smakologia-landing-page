---
import { siteConfig } from '../config/site';
---

<section
  id="kontakt"
  aria-labelledby="contact-heading"
  class="border-t border-cream-300/70 py-16 sm:py-24"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="text-xs font-bold tracking-widest text-clay-700 uppercase">
          Kontakt — Dietetyk Będzin
        </p>
        <h2
          id="contact-heading"
          class="mt-2 font-serif text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl"
        >
          Zrób pierwszy krok do zdrowej zmiany
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-800 sm:text-lg">
          Zadzwoń lub napisz wiadomość e-mail, aby umówić dogodny termin konsultacji w gabinecie w Będzinie przy ul. Gzichowskiej 121 lub online.
        </p>

        <div class="mt-8 space-y-4">
          <div class="flex items-start gap-4 rounded-2xl border border-cream-300 bg-cream-50 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-sage-700 text-cream-50" aria-hidden="true">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xs font-bold tracking-wider text-sage-800 uppercase">Zadzwoń do mnie</h3>
              <a
                href={siteConfig.contact.phoneHref}
                class="mt-1 inline-block font-serif text-2xl font-bold text-ink-900 hover:text-sage-700 hover:underline"
              >
                {siteConfig.contact.phoneDisplay}
              </a>
              <p class="mt-1 text-xs text-ink-700">
                Jeśli prowadzę konsultację i nie mogę odebrać, oddzwonię najszybciej jak to możliwe.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4 rounded-2xl border border-cream-300 bg-cream-50 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-sage-700 text-cream-50" aria-hidden="true">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path stroke-linecap="round" stroke-linejoin="round" d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </div>
            <div>
              <h3 class="text-xs font-bold tracking-wider text-sage-800 uppercase">Napisz e-mail</h3>
              <a
                href={siteConfig.contact.emailHref}
                class="mt-1 inline-block font-serif text-xl font-bold text-ink-900 hover:text-sage-700 hover:underline break-all"
              >
                {siteConfig.contact.email}
              </a>
              <p class="mt-1 text-xs text-ink-700">
                Opisz krótko swój cel lub załącz pytanie o wolne terminy wizyt.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4 rounded-2xl border border-cream-300 bg-cream-50 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-sage-700 text-cream-50" aria-hidden="true">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </div>
            <div>
              <h3 class="text-xs font-bold tracking-wider text-sage-800 uppercase">Adres gabinetu</h3>
              <address class="mt-1 not-italic font-serif text-xl font-bold text-ink-900">
                {siteConfig.contact.address.fullDisplay}
              </address>
              <p class="mt-1 text-xs leading-relaxed text-ink-700">
                {siteConfig.contact.address.locationHighlight}
              </p>
            </div>
          </div>

          <div class="rounded-2xl border border-cream-300 bg-cream-50 p-5">
            <h3 class="text-xs font-bold tracking-wider text-sage-800 uppercase">
              Obserwuj Smakologię w mediach społecznościowych
            </h3>
            <div class="mt-3 flex flex-wrap gap-3">
              <a
                href={siteConfig.socials.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2.5 rounded-xl border border-cream-300 bg-cream-100 px-4 py-2.5 text-sm font-bold text-ink-900 transition-colors hover:border-sage-700 hover:bg-sage-50 hover:text-sage-800"
              >
                <svg class="h-4 w-4 shrink-0 text-sage-700" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M13.5 22v-8.2h2.8l.4-3.2h-3.2V8.5c0-.9.3-1.6 1.6-1.6h1.7V4.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.3H7.3v3.2h2.8V22h3.4Z" />
                </svg>
                <span>Facebook (@Smakologiadietetyk)</span>
              </a>
              <a
                href={siteConfig.socials.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2.5 rounded-xl border border-cream-300 bg-cream-100 px-4 py-2.5 text-sm font-bold text-ink-900 transition-colors hover:border-sage-700 hover:bg-sage-50 hover:text-sage-800"
              >
                <svg class="h-4 w-4 shrink-0 text-sage-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                  <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
                </svg>
                <span>Instagram (@smakoologia)</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6">
        <div class="flex h-full flex-col justify-between rounded-3xl border border-cream-300 bg-cream-50 p-6 shadow-md sm:p-8">
          <div>
            <div class="flex items-center justify-between gap-4 border-b border-cream-200 pb-4">
              <div>
                <p class="text-xs font-bold tracking-wider text-sage-800 uppercase">Mapa i wskazówki dojazdu</p>
                <h3 class="mt-1 font-serif text-2xl font-bold text-ink-900">
                  Smakologia — {siteConfig.contact.address.fullDisplay}
                </h3>
              </div>
              <span class="rounded-xl bg-sage-100 px-3 py-1.5 text-xs font-bold text-sage-800">
                Zjazd DK86
              </span>
            </div>

            <div class="mt-6 rounded-2xl border border-cream-300 bg-sage-50 p-6">
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-sage-700 text-cream-50" aria-hidden="true">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21" />
                    <line x1="9" x2="9" y1="3" y2="18" />
                    <line x1="15" x2="15" y1="6" y2="21" />
                  </svg>
                </span>
                <div>
                  <p class="text-sm font-bold text-ink-900">Współrzędne GPS: 50.3308° N, 19.1246° E</p>
                  <p class="text-xs text-ink-700">Będzin (Gzichów) — szybki zjazd z trasy Katowice – Siewierz (DK86)</p>
                </div>
              </div>

              <div class="mt-5 grid grid-cols-2 gap-3 text-xs sm:grid-cols-3">
                <div class="rounded-xl bg-cream-50 p-3 ring-1 ring-cream-300">
                  <p class="font-bold text-ink-900">Katowice</p>
                  <p class="text-ink-700">ok. 12–16 min (DK86)</p>
                </div>
                <div class="rounded-xl bg-cream-50 p-3 ring-1 ring-cream-300">
                  <p class="font-bold text-ink-900">Sosnowiec</p>
                  <p class="text-ink-700">ok. 8–12 min (DK86)</p>
                </div>
                <div class="rounded-xl bg-cream-50 p-3 ring-1 ring-cream-300">
                  <p class="font-bold text-ink-900">Dąbrowa Górnicza</p>
                  <p class="text-ink-700">ok. 10–14 min</p>
                </div>
                <div class="rounded-xl bg-cream-50 p-3 ring-1 ring-cream-300">
                  <p class="font-bold text-ink-900">Chorzów</p>
                  <p class="text-ink-700">ok. 15–20 min</p>
                </div>
                <div class="rounded-xl bg-cream-50 p-3 ring-1 ring-cream-300">
                  <p class="font-bold text-ink-900">Siewierz</p>
                  <p class="text-ink-700">ok. 12–15 min (DK86)</p>
                </div>
                <div class="rounded-xl bg-cream-50 p-3 ring-1 ring-cream-300">
                  <p class="font-bold text-ink-900">Cała Polska</p>
                  <p class="text-ink-700">Konsultacje Online</p>
                </div>
              </div>
            </div>

            <div class="mt-6 rounded-2xl bg-cream-100 p-4 text-xs leading-relaxed text-ink-800">
              <p class="font-bold text-ink-900">Godziny przyjęć:</p>
              <p class="mt-1">{siteConfig.contact.openingHoursDisplay}</p>
            </div>
          </div>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a
              href={siteConfig.contact.googleMapsDirectionsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex flex-1 items-center justify-center gap-2 rounded-2xl bg-sage-700 px-6 py-4 text-sm font-bold text-cream-50 transition-colors hover:bg-sage-800"
            >
              <span>Otwórz mapę i nawigację Google Maps</span>
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M7 7h10v10" />
              </svg>
            </a>
            <a
              href={siteConfig.contact.phoneHref}
              class="inline-flex items-center justify-center rounded-2xl border-2 border-sage-700 px-6 py-4 text-sm font-bold text-sage-800 transition-colors hover:bg-sage-50"
            >
              Zadzwoń teraz
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
