---
import { Image } from 'astro:assets';
import logoSmakologia from '../assets/images/logo-smakologia.png';
import { siteConfig } from '../config/site';
---

<section
  id="o-mnie"
  aria-labelledby="about-heading"
  class="py-16 sm:py-24"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-start gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="rounded-3xl border border-cream-300 bg-cream-50 p-6 shadow-sm sm:p-8">
          <div class="w-full overflow-hidden rounded-2xl bg-sage-800 p-6 text-cream-50 flex flex-col justify-between">
            <div class="flex items-center justify-between gap-4">
              <span class="rounded-full bg-cream-50/15 px-3.5 py-1 text-xs font-bold tracking-wider uppercase">
                Smakologia • Będzin
              </span>
              <Image
                src={logoSmakologia}
                alt="Smakologia — Dietetyk kliniczny"
                width={112}
                height={112}
                format="webp"
                quality="high"
                loading="lazy"
                class="h-12 w-12 rounded-full bg-cream-50 object-contain p-0.5"
              />
            </div>

            <div class="my-auto py-4">
              <p class="font-serif text-2xl font-bold leading-snug text-cream-50 sm:text-3xl">
                „{siteConfig.specialist.philosophyQuote}”
              </p>
              <p class="mt-3 text-sm text-cream-200">
                {siteConfig.specialist.roleTitle}
              </p>
            </div>

            <div class="border-t border-cream-50/20 pt-3 text-xs text-cream-200 flex items-center justify-between">
              <span>ul. Gzichowska 121, Będzin</span>
              <span>Gabinet & Online</span>
            </div>
          </div>

          <div class="mt-6 space-y-3">
            <div class="flex items-center gap-3 rounded-xl bg-cream-100 px-4 py-3">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-sage-700 text-xs font-bold text-cream-50" aria-hidden="true">01</span>
              <p class="text-sm font-semibold text-ink-900">Indywidualne ścieżki żywieniowe dopasowane do Ciebie</p>
            </div>
            <div class="flex items-center gap-3 rounded-xl bg-cream-100 px-4 py-3">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-sage-700 text-xs font-bold text-cream-50" aria-hidden="true">02</span>
              <p class="text-sm font-semibold text-ink-900">Empatia, zrozumienie i brak oceniania na każdym etapie</p>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <p class="text-xs font-bold tracking-widest text-clay-700 uppercase">
          O mnie i mojej misji
        </p>
        <h2
          id="about-heading"
          class="mt-2 font-serif text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl"
        >
          Dietetyk kliniczny i psychodietetyk — Twój doradca na drodze do zdrowia i pięknej sylwetki
        </h2>

        <div class="mt-6 space-y-4 text-base leading-relaxed text-ink-800 sm:text-lg">
          {
            siteConfig.specialist.storyParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))
          }
          <p>
            Pracuję nad zdrową dietą z pacjentami z wieloma jednostkami chorobowymi, osobami z zaburzeniami odżywiania oraz osobami, które chcą zmienić swoje nawyki żywieniowe, aby skutecznie i trwale pozbyć się zbędnych kilogramów.
          </p>
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          {
            siteConfig.specialist.highlights.map((item) => (
              <div class="rounded-2xl border border-cream-300 bg-cream-50 p-5">
                <p class="text-xs font-bold tracking-wider text-sage-800 uppercase">{item.label}</p>
                <p class="mt-1 font-serif text-xl font-bold text-ink-900">{item.value}</p>
                <p class="mt-2 text-xs leading-relaxed text-ink-700">{item.detail}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
