---
import { Image } from 'astro:assets';
import logoSmakologia from '../assets/images/logo-smakologia.png';
import { siteConfig } from '../config/site';
---

<header
  id="top"
  class="sticky top-0 z-40 border-b border-cream-300/80 before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:bg-cream-50/95 before:backdrop-blur-md"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2.5 sm:px-6 lg:px-8">
    <a
      href="#top"
      class="group relative z-50 flex items-center gap-3 rounded-lg focus-visible:outline-sage-700"
      aria-label="Smakologia — powrót na górę strony"
    >
      <Image
        src={logoSmakologia}
        alt="Smakologia — Dietetyk kliniczny i psychodietetyk Będzin"
        width={112}
        height={112}
        format="webp"
        quality="high"
        loading="eager"
        fetchpriority="high"
        class="h-14 w-14 rounded-full object-contain shadow-xs"
      />
      <div class="flex flex-col">
        <span class="font-serif text-xl font-bold tracking-wider text-ink-900">
          SMAKOLOGIA
        </span>
        <span class="text-[11px] font-bold tracking-widest text-sage-700 uppercase">
          Dietetyk kliniczny
        </span>
      </div>
    </a>

    <nav aria-label="Główna nawigacja" class="hidden lg:flex lg:items-center lg:gap-1">
      {
        siteConfig.navigation.map((item) => (
          <a
            href={item.href}
            class="rounded-lg px-3.5 py-2 text-sm font-semibold text-ink-800 transition-colors hover:bg-sage-50 hover:text-sage-800"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2.5 sm:gap-3">
      <div class="hidden items-center gap-3 md:flex">
        {
          siteConfig.booking.enabled && (
            <a
              href={siteConfig.booking.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-xl border-2 border-sage-700 px-4 py-2.5 text-sm font-bold text-sage-800 transition-colors hover:bg-sage-50"
            >
              {siteConfig.booking.ctaLabel}
            </a>
          )
        }
        <a
          href={siteConfig.contact.phoneHref}
          class="inline-flex items-center gap-2 rounded-xl bg-sage-700 px-4 py-2.5 text-sm font-bold text-cream-50 shadow-sm transition-colors hover:bg-sage-800"
        >
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          <span>{siteConfig.contact.phoneDisplay}</span>
        </a>
      </div>

      <details id="mobile-nav-menu" class="group lg:hidden">
        <summary
          class="relative z-50 flex cursor-pointer list-none items-center gap-2 rounded-xl border border-cream-300 bg-cream-100 px-3.5 py-2.5 text-sm font-bold text-ink-900 hover:bg-cream-200"
          aria-label="Otwórz menu nawigacji"
        >
          <span>Menu</span>
          <svg
            class="h-5 w-5 transition-transform group-open:rotate-180"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
          </svg>
        </summary>

        <div
          data-menu-backdrop
          aria-hidden="true"
          class="fixed inset-0 z-40 bg-ink-900/60 backdrop-blur-xs"
        ></div>

        <nav
          aria-label="Nawigacja mobilna"
          class="fixed inset-x-3 top-20 bottom-4 z-50 flex flex-col justify-between overflow-y-auto rounded-3xl border border-cream-300 bg-cream-50 p-6 shadow-2xl sm:inset-x-6"
        >
          <ul class="flex flex-col gap-1.5">
            {
              siteConfig.navigation.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="flex items-center justify-between rounded-2xl px-4 py-3.5 text-lg font-bold text-ink-900 transition-colors hover:bg-sage-50 hover:text-sage-800"
                  >
                    <span>{item.label}</span>
                    <svg class="h-5 w-5 text-sage-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="mt-6 flex flex-col gap-3 border-t border-cream-200 pt-5">
            {
              siteConfig.booking.enabled && (
                <a
                  href={siteConfig.booking.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center rounded-2xl border-2 border-sage-700 px-4 py-3.5 text-base font-bold text-sage-800 hover:bg-sage-50"
                >
                  {siteConfig.booking.ctaLabel}
                </a>
              )
            }
            <a
              href={siteConfig.contact.phoneHref}
              class="inline-flex items-center justify-center gap-2 rounded-2xl bg-sage-700 px-4 py-4 text-base font-bold text-cream-50 shadow-sm hover:bg-sage-800"
            >
              Zadzwoń: {siteConfig.contact.phoneDisplay}
            </a>
            <a
              href={siteConfig.contact.emailHref}
              class="inline-flex items-center justify-center rounded-2xl border border-cream-300 bg-cream-100 px-4 py-3.5 text-sm font-semibold text-ink-800 hover:bg-cream-200"
            >
              {siteConfig.contact.email}
            </a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const menu = document.getElementById('mobile-nav-menu');
    if (!menu) return;
    menu.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.hasAttribute('data-menu-backdrop') || target.closest('nav a')) {
        menu.removeAttribute('open');
      }
    });
  })();
</script>
