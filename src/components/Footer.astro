---
import { Image } from 'astro:assets';
import logoSmakologia from '../assets/images/logo-smakologia.png';
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-cream-300 bg-sage-900 text-cream-100">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-12">
      <div class="md:col-span-5">
        <div class="flex items-center gap-3.5">
          <Image
            src={logoSmakologia}
            alt="Logo Smakologia — Dietetyk kliniczny"
            width={112}
            height={112}
            format="webp"
            quality="high"
            loading="lazy"
            class="h-14 w-14 shrink-0 rounded-full bg-cream-50 object-contain p-0.5"
          />
          <div>
            <p class="font-serif text-2xl font-bold tracking-wide text-cream-50">
              SMAKOLOGIA
            </p>
            <p class="mt-0.5 text-xs font-bold tracking-widest text-cream-200 uppercase">
              Dietetyk kliniczny i psychodietetyk • Będzin & Online
            </p>
          </div>
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-cream-200">
          Indywidualne plany żywieniowe, dietoterapia w jednostkach chorobowych oraz wsparcie psychodietetyczne. Gabinet w Będzinie przy zjeździe z trasy DK86.
        </p>
        <div class="mt-5 flex items-center gap-3">
          <a
            href={siteConfig.socials.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Smakologia na Facebooku"
            class="inline-flex items-center gap-2 rounded-xl border border-cream-50/20 bg-cream-50/10 px-3.5 py-2 text-xs font-bold text-cream-50 transition-colors hover:bg-cream-50 hover:text-sage-900"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M13.5 22v-8.2h2.8l.4-3.2h-3.2V8.5c0-.9.3-1.6 1.6-1.6h1.7V4.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.3H7.3v3.2h2.8V22h3.4Z" />
            </svg>
            <span>Facebook</span>
          </a>
          <a
            href={siteConfig.socials.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Smakologia na Instagramie"
            class="inline-flex items-center gap-2 rounded-xl border border-cream-50/20 bg-cream-50/10 px-3.5 py-2 text-xs font-bold text-cream-50 transition-colors hover:bg-cream-50 hover:text-sage-900"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
            </svg>
            <span>Instagram</span>
          </a>
        </div>
      </div>

      <div class="md:col-span-3">
        <h2 class="text-xs font-bold tracking-wider text-cream-50 uppercase">
          Nawigacja
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            siteConfig.navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-cream-200 transition-colors hover:text-cream-50 hover:underline"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-4">
        <h2 class="text-xs font-bold tracking-wider text-cream-50 uppercase">
          Dane kontaktowe
        </h2>
        <address class="mt-4 space-y-2 text-sm not-italic text-cream-200">
          <p class="font-semibold text-cream-50">{siteConfig.contact.address.fullDisplay}</p>
          <p>
            Tel.:{' '}
            <a href={siteConfig.contact.phoneHref} class="font-semibold text-cream-50 hover:underline">
              {siteConfig.contact.phoneDisplay}
            </a>
          </p>
          <p>
            E-mail:{' '}
            <a href={siteConfig.contact.emailHref} class="font-semibold text-cream-50 hover:underline">
              {siteConfig.contact.email}
            </a>
          </p>
          <p class="pt-2 text-xs text-cream-200">
            Obszar działania: Będzin, Katowice, Sosnowiec, Chorzów, Dąbrowa Górnicza, Siewierz oraz konsultacje online.
          </p>
        </address>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-cream-50/15 pt-8 text-xs text-cream-200 sm:flex-row">
      <p>© {currentYear} {siteConfig.brandName}. Wszelkie prawa zastrzeżone.</p>
      <p>Strona zoptymalizowana pod kątem dostępności (WCAG 2.2 AA) i prywatności (brak plików cookies śledzących).</p>
    </div>
  </div>
</footer>
